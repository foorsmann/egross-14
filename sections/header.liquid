<header class="header" data-header>
  <div class="header__inner">
    {% if section.settings.logo != blank %}
      <a class="header__logo" href="{{ routes.root_url }}">
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
      </a>
    {% else %}
      <a class="header__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
    {% endif %}

    <nav class="header__nav" aria-label="{{ 'general.navigation' | t }}">
      <ul class="header__menu">
        {% for link in section.settings.menu.links %}
          <li class="header__menu-item">
            {% if link.links != blank %}
              <button class="header__link" data-mega-trigger aria-expanded="false" aria-controls="MegaMenu-{{ forloop.index }}">
                {{ link.title }}
              </button>
              <div class="mega-menu" id="MegaMenu-{{ forloop.index }}" data-mega-dropdown hidden>
                <ul class="mega-menu__list">
                  {% for child in link.links %}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% else %}
              <a class="header__link" href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <button class="header__toggle" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu">
      <span class="visually-hidden">{{ 'general.menu' | t }}</span>
    </button>
  </div>

  <nav id="MobileMenu" class="header__mobile" hidden data-mobile-menu>
    <ul class="header__mobile-list">
      {% for link in section.settings.menu.links %}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% if link.links != blank %}
            <ul>
              {% for child in link.links %}
                <li><a href="{{ child.url }}">{{ child.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>

  {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
  {{ 'mega-menu.js' | asset_url | script_tag: defer: true }}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
